# =====================================================================
# Playwright BDD Framework - environment variables
#
# Copy this file to `.env` and adjust values as needed.
# NOTE: `.env` is gitignored - never commit real secrets.
# =====================================================================

# Target environment: dev | test | uat
ENV=dev

# Browser: chromium | firefox | webkit
BROWSER=chromium

# Run browsers headless (true) or headed (false)
HEADLESS=true

# Capture a Playwright trace (zip) for every scenario (true | false)
TRACE=false

# Console log level: debug | info | warn | error
LOG_LEVEL=info

# Optional overrides - take precedence over data/environments/<ENV>.json.
# These are DEMO credentials for the bundled local demo app.
# BASE_URL=http://localhost:3000
# TEST_USERNAME=standard_user
# TEST_PASSWORD=secret_sauce
